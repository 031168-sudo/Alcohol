# Ключ подписи и пароли лежат в репозитории по решению владельца.
# Не переноси ключ в публичный репозиторий без необходимости: любой, кто получит ключ, сможет подписать APK от твоего имени.
storeFile=keys/alcohol-release.jks
storePassword=(см. keystore.properties в репозитории)
keyAlias=alcohol
keyPassword=(см. keystore.properties в репозитории)
