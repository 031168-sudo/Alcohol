# Скопируй в keystore.properties и заполни. Файл в git не попадает.
# Ключ создай один раз и храни в надёжном месте: без него обновления не встанут поверх установленной версии.
#
# keytool -genkeypair -v -keystore ~/keys/alcohol-release.jks -alias alcohol -keyalg RSA -keysize 2048 -validity 10000
storeFile=../keys/alcohol-release.jks
storePassword=ЗАМЕНИ
keyAlias=alcohol
keyPassword=ЗАМЕНИ
